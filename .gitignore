# 缓存/构建文件
__pycache__/
*.egg-info/

# 编辑器/系统文件
.DS_Store
*.swp
*.swo

# ZCode 本地状态（config.json 为共享的 MCP 配置，需入库）
.zcode/*
!.zcode/config.json

# 设计文档（非项目文件）
design.md

# 用户持仓配置（改为仅由 AgentMemory 管理）
portfolio.json

# 动态池缓存（自动生成，含实时数据）
.hk_dynamic_pool_cache.json

# 分析报告输出（自动生成，含实时数据）
report/

# AgentMemory 本地记忆库（用户隐私数据，禁止入库）
data/

# 无关文件
ve.pptx
*.pptx
